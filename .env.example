# AutoBassTab environment variables

# Output directory for generated files (default: ./output)
AUTOBASS_OUTPUT_DIR=./output

# Default fingering strategy: LOWEST_POSITION | MIN_MOVEMENT | OPEN_STRING_PREFER
AUTOBASS_STRATEGY=LOWEST_POSITION

# Demucs model name (default: htdemucs)
DEMUCS_MODEL=htdemucs
